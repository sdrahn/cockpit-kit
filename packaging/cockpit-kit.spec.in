Name: cockpit-kit
Version: %{VERSION}
Release: 1%{?dist}
Summary: Cockpit UI for the Kit AI coding agent
License: LGPL-2.1-or-later

# distributions which ship nodejs-esbuild can rebuild the bundle during package build
%if 0%{?fedora} >= 42
%define rebuild_bundle 1
%endif

Source0: https://github.com/sdrahn/cockpit-kit/releases/download/%{version}/%{name}-%{version}.tar.xz
Source1: https://github.com/sdrahn/cockpit-kit/releases/download/%{version}/%{name}-node-%{version}.tar.xz

BuildArch: noarch
%if ! 0%{?suse_version}
ExclusiveArch: %{nodejs_arches} noarch
%endif
BuildRequires: make
%if 0%{?suse_version}
# Suse's package has a different name
BuildRequires: appstream-glib
%else
BuildRequires: libappstream-glib
%endif
%if 0%{?rhel} && 0%{?rhel} <= 8
BuildRequires: libappstream-glib-devel
%endif
%if %{defined rebuild_bundle}
BuildRequires: /usr/bin/node
BuildRequires: nodejs-esbuild
%endif

Requires: cockpit-bridge

# Kit itself (https://github.com/mark3labs/kit) is not packaged for most
# distributions yet, so it is intentionally not a hard dependency: without
# the "kit" binary on PATH, the page shows install instructions instead.
Recommends: kit

%{NPM_PROVIDES}

%description
Adds a page to Cockpit for the Kit AI coding agent (mark3labs/kit): an
embedded terminal for interactive Kit sessions, plus status, authentication,
model, extension, GitHub integration and configuration management.

%prep
%autosetup -n %{name}
%if %{defined rebuild_bundle}
%setup -q -D -T -a 1 -n %{name}
%endif


%build
%if %{defined rebuild_bundle}
rm -rf dist
# HACK: node module packaging is broken in Fedora ≤ 43; should be in
# common location, not major version specific one
NODE_ENV=production NODE_PATH=/usr/lib/node_modules:$(echo /usr/lib/node_modules_*) ./build.js
%else
# Use pre-built bundle on distributions without nodejs-esbuild
%endif


%install
%make_install PREFIX=/usr

# drop source maps, they are large and just for debugging
find %{buildroot}%{_datadir}/cockpit/ -name '*.map' | xargs --no-run-if-empty rm --verbose

%check
appstream-util validate-relax --nonet %{buildroot}/%{_datadir}/metainfo/*

%files
%doc README.md
%license LICENSE dist/index.js.LEGAL.txt
%{_datadir}/cockpit/*
%{_datadir}/metainfo/*

%changelog
* Tue Oct 27 2026 Daniel Rahn <drahn76@gmail.com> - 0.1.10-1
- Show web pages Kit opens (OAuth sign-in for providers and remote MCP
  servers) in a panel above the terminal, with the full URL and Copy and
  Open buttons, instead of Kit trying to start a browser on the server
- Finish sign-ins that redirect to a "localhost" callback by pasting the
  browser's final address into that panel

* Tue Oct 20 2026 Daniel Rahn <drahn76@gmail.com> - 0.1.9-1
- Copy text selected with the mouse in Kit's TUI to the browser clipboard
  (Kit copies via OSC 52); Shift+drag (Option+drag on macOS) selects in
  the terminal instead

* Thu Oct 15 2026 Daniel Rahn <drahn76@gmail.com> - 0.1.8-1
- List the page above Tools, next to MCP Gateway
- Attach the source tarball to each GitHub release

* Mon Sep 07 2026 Daniel Rahn <drahn76@gmail.com> - 0.1.7-1
